        </mxCell>
        <mxCell id="legend1" value="UQ* = filtered unique index   1 = exactly one   0..* = zero or many   0..1 = zero or one" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontStyle=0;fontColor=#BFBFBF;fontFamily=Courier New;" vertex="1" parent="1">
