        <mxCell id="Roles" value="&lt;div style=&quot;font-weight:bold;font-size:18px;padding:12px;border-bottom:1px solid #FFFFFF&quot;&gt;Roles&lt;/div&gt;&lt;div style=&quot;padding:12px;font-size:14px;line-height:24px;white-space:pre&quot;&gt;RoleId     TINYINT        NOT NULL [PK]&lt;br&gt;RoleName   NVARCHAR(20)   NOT NULL [UQ]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#111111;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=14;" vertex="1" parent="1">
