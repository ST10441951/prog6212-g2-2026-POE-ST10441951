        <mxCell id="Enrolments" value="&lt;div style=&quot;font-weight:bold;font-size:18px;padding:12px;border-bottom:1px solid #FFFFFF&quot;&gt;Enrolments&lt;/div&gt;&lt;div style=&quot;padding:12px;font-size:14px;line-height:24px;white-space:pre&quot;&gt;EnrolmentId              INT IDENTITY(1,1)    NOT NULL [PK]&lt;br&gt;ParticipantUserId        INT                  NOT NULL [FK]&lt;br&gt;EventId                  INT                  NOT NULL [FK]&lt;br&gt;EventCategoryId          INT                  NOT NULL [FK]&lt;br&gt;EnrolmentDate            DATETIME2(0)         NOT NULL&lt;br&gt;Status                   NVARCHAR(20)         NOT NULL&lt;br&gt;BibNumber                NVARCHAR(20)         NULL     [UQ*]&lt;br&gt;UpdatedAt                DATETIME2(0)         NULL&lt;/div&gt;&lt;div style=&quot;padding:8px 12px;border-top:1px solid #777777;font-size:14px;line-height:24px&quot;&gt;UQ1 (ParticipantUserId, EventId)&lt;br&gt;UQ2* (EventId, BibNumber) WHERE BibNumber IS NOT NULL&lt;br&gt;FK (EventCategoryId, EventId) -&amp;gt;&lt;br&gt;EventCategories(EventCategoryId, EventId)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#111111;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=14;" vertex="1" parent="1">
