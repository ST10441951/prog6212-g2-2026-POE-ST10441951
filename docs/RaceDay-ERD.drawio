        <mxCell id="Users" value="&lt;div style=&quot;font-weight:bold;font-size:18px;padding:12px;border-bottom:1px solid #FFFFFF&quot;&gt;Users&lt;/div&gt;&lt;div style=&quot;padding:12px;font-size:14px;line-height:24px;white-space:pre&quot;&gt;UserId                   INT IDENTITY(1,1)    NOT NULL [PK]&lt;br&gt;RoleId                   TINYINT              NOT NULL [FK]&lt;br&gt;FirstName                NVARCHAR(50)         NOT NULL&lt;br&gt;LastName                 NVARCHAR(50)         NOT NULL&lt;br&gt;Email                    NVARCHAR(254)        NOT NULL [UQ]&lt;br&gt;PasswordHash             NVARCHAR(255)        NOT NULL&lt;br&gt;PhoneNumber              NVARCHAR(20)         NULL&lt;br&gt;DateOfBirth              DATE                 NULL&lt;br&gt;ProfilePictureBlobName   NVARCHAR(255)        NULL&lt;br&gt;IsActive                 BIT                  NOT NULL&lt;br&gt;CreatedAt                DATETIME2(0)         NOT NULL&lt;br&gt;UpdatedAt                DATETIME2(0)         NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#111111;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="130" width="680" height="368" as="geometry" />
        </mxCell>
        <mxCell id="Events" value="&lt;div style=&quot;font-weight:bold;font-size:18px;padding:12px;border-bottom:1px solid #FFFFFF&quot;&gt;Events&lt;/div&gt;&lt;div style=&quot;padding:12px;font-size:14px;line-height:24px;white-space:pre&quot;&gt;EventId                  INT IDENTITY(1,1)    NOT NULL [PK]&lt;br&gt;OrganiserUserId          INT                  NOT NULL [FK]&lt;br&gt;EventName                NVARCHAR(120)        NOT NULL&lt;br&gt;EventType                NVARCHAR(20)         NOT NULL&lt;br&gt;Description              NVARCHAR(1000)       NOT NULL&lt;br&gt;BannerImageBlobName      NVARCHAR(255)        NULL&lt;br&gt;DistanceKm               DECIMAL(6,2)         NOT NULL&lt;br&gt;EventDateTime            DATETIME2(0)         NOT NULL&lt;br&gt;EntryClosingDateTime     DATETIME2(0)         NOT NULL&lt;br&gt;VenueName                NVARCHAR(120)        NOT NULL&lt;br&gt;AddressLine1             NVARCHAR(120)        NOT NULL&lt;br&gt;City                     NVARCHAR(80)         NOT NULL&lt;br&gt;Province                 NVARCHAR(30)         NOT NULL&lt;br&gt;Latitude                 DECIMAL(9,6)         NULL&lt;br&gt;Longitude                DECIMAL(9,6)         NULL&lt;br&gt;Status                   NVARCHAR(20)         NOT NULL&lt;br&gt;CreatedAt                DATETIME2(0)         NOT NULL&lt;br&gt;UpdatedAt                DATETIME2(0)         NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#111111;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1330" y="100" width="700" height="512" as="geometry" />
        </mxCell>
        <mxCell id="EventCategories" value="&lt;div style=&quot;font-weight:bold;font-size:18px;padding:12px;border-bottom:1px solid #FFFFFF&quot;&gt;EventCategories&lt;/div&gt;&lt;div style=&quot;padding:12px;font-size:14px;line-height:24px;white-space:pre&quot;&gt;EventCategoryId          INT IDENTITY(1,1)    NOT NULL [PK]&lt;br&gt;EventId                  INT                  NOT NULL [FK]&lt;br&gt;CategoryName             NVARCHAR(80)         NOT NULL&lt;br&gt;DistanceKm               DECIMAL(6,2)         NOT NULL&lt;br&gt;MinimumAge               TINYINT              NULL&lt;br&gt;MaximumAge               TINYINT              NULL&lt;br&gt;EntryFee                 DECIMAL(10,2)        NOT NULL&lt;br&gt;Capacity                 INT                  NULL&lt;br&gt;IsAvailable              BIT                  NOT NULL&lt;br&gt;CreatedAt                DATETIME2(0)         NOT NULL&lt;br&gt;UpdatedAt                DATETIME2(0)         NULL&lt;/div&gt;&lt;div style=&quot;padding:8px 12px;border-top:1px solid #777777;font-size:14px;line-height:24px&quot;&gt;UQ1 (EventId, CategoryName)&lt;br&gt;UQ2 (EventCategoryId, EventId)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#111111;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="2160" y="130" width="680" height="412" as="geometry" />
