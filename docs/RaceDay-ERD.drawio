        <mxCell id="legend0" value="PK = primary key   FK = foreign key   UQ = single-column unique key   UQ1/UQ2 = composite keys shown in the table" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontStyle=0;fontColor=#BFBFBF;fontFamily=Courier New;" vertex="1" parent="1">
