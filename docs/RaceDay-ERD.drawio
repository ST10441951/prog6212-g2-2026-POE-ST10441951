        <mxCell id="EventRoutes" value="&lt;div style=&quot;font-weight:bold;font-size:18px;padding:12px;border-bottom:1px solid #FFFFFF&quot;&gt;EventRoutes&lt;/div&gt;&lt;div style=&quot;padding:12px;font-size:14px;line-height:24px;white-space:pre&quot;&gt;RouteId                  INT IDENTITY(1,1)    NOT NULL [PK]&lt;br&gt;EventCategoryId          INT                  NOT NULL [FK, UQ]&lt;br&gt;RouteName                NVARCHAR(120)        NOT NULL&lt;br&gt;StartLocation            NVARCHAR(200)        NOT NULL&lt;br&gt;FinishLocation           NVARCHAR(200)        NOT NULL&lt;br&gt;RouteDescription         NVARCHAR(1000)       NOT NULL&lt;br&gt;RouteMapUrl              NVARCHAR(500)        NULL&lt;br&gt;ElevationGainMetres      INT                  NULL&lt;br&gt;CreatedAt                DATETIME2(0)         NOT NULL&lt;br&gt;UpdatedAt                DATETIME2(0)         NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#111111;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="2970" y="130" width="700" height="320" as="geometry" />
