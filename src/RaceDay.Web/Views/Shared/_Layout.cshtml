@* Shared Razor layout and Bootstrap grid: Microsoft (2026); Bootstrap (2026).
   https://learn.microsoft.com/en-us/aspnet/core/mvc/views/layout?view=aspnetcore-10.0
   https://learn.microsoft.com/en-us/aspnet/core/security/authorization/roles?view=aspnetcore-10.0
   https://getbootstrap.com/docs/5.3/layout/grid/
   https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA/Reference/Attributes/aria-current
   Accessed: 19 November 2026. *@
@{
    bool signedIn = User.Identity?.IsAuthenticated is true;
    bool organiser = User.IsInRole("Organiser");
    string? controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string? action = ViewContext.RouteData.Values["action"]?.ToString();
    bool homePage = string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        || string.Equals(controller, "Events", StringComparison.OrdinalIgnoreCase);
    bool loginPage = string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Login", StringComparison.OrdinalIgnoreCase);
    bool registerPage = string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Register", StringComparison.OrdinalIgnoreCase);
    bool roleHome = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), organiser ? "Organiser" : "Participant", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
    bool imagePage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Images", StringComparison.OrdinalIgnoreCase);
    bool ownedEventsPage = (imagePage && organiser) || string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "EventResults", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Enrolments", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Categories", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "OwnedEvents", StringComparison.OrdinalIgnoreCase) ||
        (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Organiser", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Events", StringComparison.OrdinalIgnoreCase));
    bool profilePage = (imagePage && !organiser) || string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Profile", StringComparison.OrdinalIgnoreCase);
    bool resultsPage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Results", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Find South African running, walking and cycling events with RaceDay." />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="RaceDay home">Race<span>Day</span></a>
            <nav class="header-nav" aria-label="Main navigation">
                <a class="nav-link @(homePage ? "active" : "")" asp-controller="Home" asp-action="Index" aria-current="@(homePage ? "page" : null)">Find events</a>
                @if (!signedIn)
                {
                    <a class="nav-link @(loginPage ? "active" : "")" asp-controller="Account" asp-action="Login" aria-current="@(loginPage ? "page" : null)">Sign in</a>
                    <a class="btn btn-race nav-register" asp-controller="Account" asp-action="Register" aria-current="@(registerPage ? "page" : null)">Create account</a>
                }
                else
                {
                    <a class="nav-link @(roleHome ? "active" : "")" asp-controller="@(organiser ? "Organiser" : "Participant")" asp-action="Index" aria-current="@(roleHome ? "page" : null)">@(organiser ? "Organiser home" : "My account")</a>
                    @if (organiser)
                    {
                        <a class="nav-link @(ownedEventsPage ? "active" : "")" asp-controller="Organiser" asp-action="Events" aria-current="@(ownedEventsPage ? "page" : null)">My events</a>
                    }
                    else
                    {
                        bool entriesPage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Entries", StringComparison.OrdinalIgnoreCase);
                        <a class="nav-link @(entriesPage ? "active" : "")" asp-controller="Entries" asp-action="Index" aria-current="@(entriesPage ? "page" : null)">My entries</a>
                        <a class="nav-link @(resultsPage ? "active" : "")" asp-controller="Results" asp-action="Index" aria-current="@(resultsPage ? "page" : null)">My results</a>
                    }
                    <a class="nav-link @(profilePage ? "active" : "")" asp-controller="Profile" asp-action="Index" aria-current="@(profilePage ? "page" : null)">My profile</a>
                    <span class="signed-in-user">@User.Identity?.Name <span>(@(organiser ? "Organiser" : "Participant"))</span></span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="nav-signout" type="submit">Sign out</button>
                    </form>
                }
            </nav>
        </div>
    </header>
    <main id="main-content" tabindex="-1">
        @if (Context.Items.ContainsKey("RaceDay.AccountUnavailable"))
        {
            <div class="container mt-3"><div class="alert alert-warning" role="alert">Account checks are temporarily unavailable. Please try again shortly.</div></div>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container footer-inner">
            <span class="footer-brand">RaceDay</span>
            <span>South African running, walking and cycling.</span>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
