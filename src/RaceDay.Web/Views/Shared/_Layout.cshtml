@* Shared Razor layout and Bootstrap grid: Microsoft (2026); Bootstrap (2026).
   https://learn.microsoft.com/en-us/aspnet/core/mvc/views/layout?view=aspnetcore-10.0
   https://getbootstrap.com/docs/5.3/layout/grid/
   Accessed: 18 November 2026. *@
@inject RaceDay.Web.Services.WebSessionStore Sessions
@{
    var login = await Sessions.ReadAsync(Context);
    bool homePage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Find South African running, walking and cycling events with RaceDay." />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="RaceDay home">Race<span>Day</span></a>
            <nav class="header-nav" aria-label="Main navigation">
                <a class="nav-link @(homePage ? "active" : "")" asp-controller="Home" asp-action="Index" aria-current="@(homePage ? "page" : null)">Find events</a>
                @if (login is null)
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="btn btn-race nav-register" asp-controller="Account" asp-action="Register">Create account</a>
                }
                else
                {
                    <span class="signed-in-user">@login.FirstName <span>(@login.Role)</span></span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="nav-signout" type="submit">Sign out</button>
                    </form>
                }
            </nav>
        </div>
    </header>
    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container footer-inner">
            <span class="footer-brand">RaceDay</span>
            <span>South African running, walking and cycling.</span>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
