@{
    ViewData["Title"] = "My account";
}
<section class="events-section">
    <div class="container">
        <div class="page-intro">
            <p class="eyebrow">Participant</p>
            <h1>Welcome, @User.Identity?.Name</h1>
            <p>Your RaceDay participant account.</p>
        </div>
        <div class="account-card role-home-card">
            <h2>Find your next event</h2>
            <p>Browse upcoming events across South Africa. Filter by sport and province to find one near you.</p>
            <a class="btn btn-race" asp-controller="Home" asp-action="Index">Find events</a>
            <a class="ms-3" asp-controller="Entries" asp-action="Index">My entries</a>
            <a class="ms-3" asp-controller="Results" asp-action="Index">My results</a>
            <a class="ms-3" asp-controller="Profile" asp-action="Index">My profile</a>
        </div>
    </div>
</section>
