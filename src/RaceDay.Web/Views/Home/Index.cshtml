@model HomeViewModel
@{
    ViewData["Title"] = "Find your next event";
}
<section class="events-section" aria-labelledby="page-heading">
    <div class="container page-container">
        <div class="page-intro">
            <h1 id="page-heading">Find an event that suits you.</h1>
            <p>Browse running, walking and cycling events across South Africa.</p>
        </div>
        <form class="event-search" asp-controller="Home" asp-action="Index" method="get" aria-label="Find events">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="province">Province</label>
                    <select class="form-select" id="province" name="province">
                        <option value="">All provinces</option>
                        @foreach (var province in new[] { "Eastern Cape", "Free State", "Gauteng", "KwaZulu-Natal", "Limpopo", "Mpumalanga", "Northern Cape", "North West", "Western Cape" })
                        {
                            <option value="@province" selected="@(string.Equals(Model.Province, province, StringComparison.OrdinalIgnoreCase))">@province</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="event-type">Event type</label>
                    <select class="form-select" id="event-type" name="eventType">
                        <option value="">All types</option>
                        @foreach (var eventType in new[] { "Running", "Walking", "Cycling" })
                        {
                            <option value="@eventType" selected="@(string.Equals(Model.EventType, eventType, StringComparison.OrdinalIgnoreCase))">@eventType</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-race search-button" type="submit">Find events</button>
                </div>
            </div>
        </form>
        <div id="upcoming" aria-labelledby="events-heading">
        <div class="section-heading">
            <h2 id="events-heading">Upcoming events</h2>
            @if (Model.ErrorMessage is null)
            {
                <p>Showing @Model.Events.Count of @Model.TotalCount events</p>
            }
        </div>
        @if (Model.ErrorMessage is not null)
        {
            <div class="notice" role="alert">
                <h3>We couldn't load the events</h3>
                <p>@Model.ErrorMessage</p>
                <a asp-controller="Home" asp-action="Index" asp-fragment="upcoming">Try again</a>
            </div>
        }
        else if (Model.Events.Count == 0)
        {
            <div class="notice">
                @if (Model.EventType is not null || Model.Province is not null)
                {
                    <h3>No events match these filters</h3>
                    <p>Choose another province or event type.</p>
                }
                else
                {
                    <h3>No upcoming events yet</h3>
                    <p>Check back soon for new events.</p>
                }
            </div>
        }
        else
        {
            <div class="event-list">
                @foreach (var item in Model.Events)
                {
                    var localDate = item.EventDateTime.ToOffset(TimeSpan.FromHours(2));
                    <article class="event-row" aria-labelledby="event-@item.EventId">
                        <time class="event-date" datetime="@item.EventDateTime.ToString("O", CultureInfo.InvariantCulture)">
                            <span>@localDate.ToString("dd", CultureInfo.InvariantCulture)</span>
                            @localDate.ToString("MMM yyyy", CultureInfo.InvariantCulture)
                        </time>
                        <div class="event-info">
                            <p class="event-type">@item.EventType</p>
                            <h3 id="event-@item.EventId">@item.EventName</h3>
                            <p class="event-location">@item.City, @item.Province</p>
                        </div>
                        <div class="event-meta">
                            <span class="event-distance">@item.DistanceKm.ToString("0.##", CultureInfo.InvariantCulture) <small>km</small></span>
                            <span class="event-status @(item.Status == "Open" ? "status-open" : "status-closed")">@item.Status</span>
                        </div>
                    </article>
                }
            </div>
        }
        @if (Model.EventType is not null || Model.Province is not null)
        {
            <a class="clear-filters" asp-controller="Home" asp-action="Index">Clear filters</a>
        }
        </div>
    </div>
</section>
