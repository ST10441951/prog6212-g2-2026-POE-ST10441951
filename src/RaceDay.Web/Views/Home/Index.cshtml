@model HomeViewModel
@{
    ViewData["Title"] = "Find your next event";
}
<section class="events-section" aria-labelledby="page-heading">
    <div class="container page-container">
        <div class="page-intro">
            <h1 id="page-heading">Find an event that suits you.</h1>
            <p>Browse running, walking and cycling events across South Africa.</p>
        </div>
        <form class="event-search" asp-controller="Home" asp-action="Index" method="get" aria-label="Find events">
            <div class="row g-3 align-items-end">
                <div class="col-md-6 col-lg-3">
                    <label class="form-label" for="province">Province</label>
                    <select class="form-select" id="province" name="province">
                        <option value="">All provinces</option>
                        @foreach (var province in new[] { "Eastern Cape", "Free State", "Gauteng", "KwaZulu-Natal", "Limpopo", "Mpumalanga", "Northern Cape", "North West", "Western Cape" })
                        {
                            <option value="@province" selected="@(string.Equals(Model.Search.Province, province, StringComparison.OrdinalIgnoreCase))">@province</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 col-lg-3">
                    <label class="form-label" for="event-type">Event type</label>
                    <select class="form-select" id="event-type" name="eventType">
                        <option value="">All types</option>
                        @foreach (var eventType in new[] { "Running", "Walking", "Cycling" })
                        {
                            <option value="@eventType" selected="@(string.Equals(Model.Search.EventType, eventType, StringComparison.OrdinalIgnoreCase))">@eventType</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 col-lg-2">
                    <label class="form-label" for="from-date">From date</label>
                    <input class="form-control" type="date" id="from-date" name="fromDate" value="@Model.Search.FromDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" aria-describedby="date-help" />
                </div>
                <div class="col-md-6 col-lg-2">
                    <label class="form-label" for="to-date">To date</label>
                    <input class="form-control" type="date" id="to-date" name="toDate" value="@Model.Search.ToDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" aria-describedby="date-help" />
                </div>
                <div class="col-lg-2">
                    <button class="btn btn-race search-button" type="submit">Find events</button>
                </div>
            </div>
            <p class="field-help mb-0" id="date-help">Date filters use UTC dates. Event times are shown in South African time (SAST).</p>
        </form>
        <div id="upcoming" aria-labelledby="events-heading">
        <div class="section-heading">
            <h2 id="events-heading">Upcoming events</h2>
            @if (Model.ErrorMessage is null)
            {
                <p>Showing @Model.Events.Count of @Model.TotalCount events</p>
            }
        </div>
        @if (Model.ErrorMessage is not null)
        {
            <div class="notice" role="alert">
                <h3>We couldn't load the events</h3>
                <p>@Model.ErrorMessage</p>
                <a asp-controller="Home" asp-action="Index" asp-all-route-data="@Model.PageRoutes(Model.Search.Page)" asp-fragment="upcoming">Try again</a>
            </div>
        }
        else if (Model.Events.Count == 0)
        {
            <div class="notice">
                @if (Model.Search.Page > 1)
                {
                    <h3>No events on this page</h3>
                    <p>Return to the first page for the latest matching events.</p>
                    <a asp-controller="Home" asp-action="Index" asp-all-route-data="@Model.PageRoutes(1)" asp-fragment="upcoming">First page</a>
                }
                else if (Model.Search.HasFilters)
                {
                    <h3>No events match these filters</h3>
                    <p>Try another province, event type or date range.</p>
                }
                else
                {
                    <h3>No upcoming events yet</h3>
                    <p>Check back soon for new events.</p>
                }
            </div>
        }
        else
        {
            <div class="event-list">
                @foreach (var item in Model.Events)
                {
                    var localDate = item.EventDateTime.ToOffset(TimeSpan.FromHours(2));
                    <article class="event-row" aria-labelledby="event-@item.EventId">
                        <time class="event-date" datetime="@item.EventDateTime.ToString("O", CultureInfo.InvariantCulture)">
                            <span>@localDate.ToString("dd", CultureInfo.InvariantCulture)</span>
                            @localDate.ToString("MMM yyyy", CultureInfo.InvariantCulture)
                        </time>
                        <div class="event-info">
                            <p class="event-type">@item.EventType</p>
                            <h3 id="event-@item.EventId"><a asp-controller="Events" asp-action="Details" asp-route-eventId="@item.EventId">@item.EventName</a></h3>
                            <p class="event-location">@item.City, @item.Province</p>
                        </div>
                        <div class="event-meta">
                            <span class="event-distance">@item.DistanceKm.ToString("0.##", CultureInfo.InvariantCulture) <small>km</small></span>
                            <span class="event-status @(item.Status == "Open" ? "status-open" : "status-closed")">@item.Status</span>
                        </div>
                    </article>
                }
            </div>
        }
        @if (Model.ErrorMessage is null && Model.TotalPages > 1)
        {
            int first = Math.Max(1, Math.Min(Model.Search.Page, Model.TotalPages) - 2);
            int last = (int)Math.Min((long)first + 4, Model.TotalPages);
            <nav class="event-pagination" aria-label="Event pages">
                <ul class="pagination flex-wrap mb-0">
                    @if (Model.Search.Page > 1)
                    {
                        <li class="page-item"><a class="page-link" asp-controller="Home" asp-action="Index" asp-all-route-data="@Model.PageRoutes(Math.Min(Model.Search.Page - 1, Model.TotalPages))" asp-fragment="upcoming">Previous</a></li>
                    }
                    @if (first > 1)
                    {
                        <li class="page-item"><a class="page-link" asp-controller="Home" asp-action="Index" asp-all-route-data="@Model.PageRoutes(1)" asp-fragment="upcoming" aria-label="First page">1</a></li>
                        <li class="page-item disabled"><span class="page-link" aria-hidden="true">…</span></li>
                    }
                    @for (int number = first; number <= last; number++)
                    {
                        <li class="page-item @(number == Model.Search.Page ? "active" : "")">
                            @if (number == Model.Search.Page)
                            {
                                <span class="page-link" aria-current="page">@number</span>
                            }
                            else
                            {
                                <a class="page-link" asp-controller="Home" asp-action="Index" asp-all-route-data="@Model.PageRoutes(number)" asp-fragment="upcoming" aria-label="Page @number">@number</a>
                            }
                        </li>
                    }
                    @if (last < Model.TotalPages)
                    {
                        <li class="page-item disabled"><span class="page-link" aria-hidden="true">…</span></li>
                        <li class="page-item"><a class="page-link" asp-controller="Home" asp-action="Index" asp-all-route-data="@Model.PageRoutes(Model.TotalPages)" asp-fragment="upcoming" aria-label="Last page">@Model.TotalPages</a></li>
                    }
                    @if (Model.Search.Page < Model.TotalPages)
                    {
                        <li class="page-item"><a class="page-link" asp-controller="Home" asp-action="Index" asp-all-route-data="@Model.PageRoutes(Model.Search.Page + 1)" asp-fragment="upcoming">Next</a></li>
                    }
                </ul>
                <p>@Model.TotalCount events · @Model.TotalPages pages</p>
            </nav>
        }
        @if (Model.Search.HasFilters)
        {
            <a class="clear-filters" asp-controller="Home" asp-action="Index">Clear filters</a>
        }
        </div>
    </div>
</section>
