@* Encoded private results, filters and paging: Microsoft (2026); Bootstrap (2026).
   https://learn.microsoft.com/en-us/aspnet/core/mvc/views/working-with-forms?view=aspnetcore-10.0
   https://getbootstrap.com/docs/5.3/components/pagination/
   Accessed: 19 November 2026. *@
@model RaceDay.Web.Models.Organiser.EventResultList
@using RaceDay.Web.Models.Results
@{ ViewData["Title"] = "Event results"; }
<section class="events-section"><div class="container">
    <a class="back-link" asp-controller="OwnedEvents" asp-action="Details" asp-route-eventId="@Model.Event.EventId">Back to event</a>
    <div class="page-intro"><h1>Event results</h1><p>@Model.Event.EventName</p>
        <a class="btn btn-race" asp-controller="Enrolments" asp-action="Index" asp-route-eventId="@Model.Event.EventId">Record a result from enrolments</a>
    </div>
    <form class="event-search" asp-action="Index" asp-route-eventId="@Model.Event.EventId" method="get">
        <div class="row g-3 align-items-end">
            <div class="col-md-4"><label class="form-label" for="result-status">Result status</label><select class="form-select" id="result-status" name="resultStatus">
                <option value="">All results</option>@foreach (string status in new[] { "Completed", "DidNotFinish", "DidNotStart", "Disqualified" }) { <option value="@status" selected="@(string.Equals(Model.Search.ResultStatus, status, StringComparison.OrdinalIgnoreCase))">@ResultDetails.Label(status)</option> }
            </select></div>
            <div class="col-md-4"><label class="form-label" for="result-category">Category</label><select class="form-select" id="result-category" name="eventCategoryId">
                <option value="">All categories</option>@foreach (var category in Model.Event.Categories) { <option value="@category.EventCategoryId" selected="@(Model.Search.EventCategoryId == category.EventCategoryId)">@category.CategoryName@(category.IsAvailable ? "" : " (Unavailable)")</option> }
            </select></div>
            <div class="col-md-4"><button class="btn btn-race" type="submit">Filter results</button><a class="d-inline-block ms-3" asp-action="Index" asp-route-eventId="@Model.Event.EventId">Clear filters</a></div>
        </div>
    </form>
    @if (Model.Error is not null) { <div class="notice" role="alert"><h2>Check the filters</h2><p>@Model.Error</p></div> }
    else if (Model.Results is { } page)
    {
        @if (page.Items.Count == 0)
        {
            <div class="notice"><h2>@(page.Page > 1 ? "No results on this page" : Model.Search.ResultStatus is not null || Model.Search.EventCategoryId is not null ? "No results match these filters" : "No official results yet")</h2>
                @if (page.Page > 1) { <a asp-action="Index" asp-route-eventId="@Model.Event.EventId" asp-route-page="1" asp-route-resultStatus="@Model.Search.ResultStatus" asp-route-eventCategoryId="@Model.Search.EventCategoryId">First page</a> }
                else { <p>Open an enrolment to record its official result.</p> }
            </div>
        }
        else
        {
            <div class="entry-list">@foreach (var result in page.Items)
            {
                <article class="detail-panel">
                    <div class="category-heading"><h2><a asp-action="Details" asp-route-eventId="@Model.Event.EventId" asp-route-enrolmentId="@result.EnrolmentId">@result.ParticipantName</a></h2><span class="event-status @(result.ResultStatus == "Completed" ? "status-open" : result.ResultStatus == "Disqualified" ? "status-cancelled" : "status-closed")">@result.StatusLabel</span></div>
                    <p>@result.CategoryName · @(result.BibNumber ?? "Bib not assigned")</p>
                    <dl class="event-facts mb-0"><div><dt>Finish time</dt><dd>@result.FinishTime</dd></div><div><dt>Overall position</dt><dd>@result.OverallPlace</dd></div><div><dt>Category position</dt><dd>@(result.ResultStatus != "Completed" ? "Not ranked" : result.CategoryPosition?.ToString(CultureInfo.InvariantCulture) ?? "Not assigned")</dd></div></dl>
                </article>
            }</div>
        }
        @if (page.TotalPages > 1)
        {
            <nav class="event-pagination" aria-label="Event result pages"><ul class="pagination flex-wrap mb-0">
                @if (page.Page > 1) { <li class="page-item"><a class="page-link" asp-action="Index" asp-route-eventId="@Model.Event.EventId" asp-route-page="@Math.Min(page.Page - 1, page.TotalPages)" asp-route-resultStatus="@Model.Search.ResultStatus" asp-route-eventCategoryId="@Model.Search.EventCategoryId">Previous</a></li> }
                @if (page.Page < page.TotalPages) { <li class="page-item"><a class="page-link" asp-action="Index" asp-route-eventId="@Model.Event.EventId" asp-route-page="@(page.Page + 1)" asp-route-resultStatus="@Model.Search.ResultStatus" asp-route-eventCategoryId="@Model.Search.EventCategoryId">Next</a></li> }
            </ul></nav>
        }
        <p class="mt-3">@(page.TotalCount) matching results · Page @(page.Page)@(page.TotalPages > 0 ? " of " + page.TotalPages.ToString(CultureInfo.InvariantCulture) : "")</p>
    }
</div></section>
