@* Shared form controls and field errors: Microsoft (2026); Bootstrap (2026).
   https://learn.microsoft.com/en-us/aspnet/core/mvc/views/working-with-forms?view=aspnetcore-10.0
   https://getbootstrap.com/docs/5.3/forms/layout/
   Accessed: 18 November 2026. *@
@model RaceDay.Web.Models.Organiser.CreateEventForm
<div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
<div class="row g-3">
    <div class="col-md-8"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control" maxlength="120" required /><span asp-validation-for="EventName" class="field-error"></span></div>
    <div class="col-md-4">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select" required><option value="">Choose a sport</option>@foreach (string sport in new[] { "Running", "Walking", "Cycling" }) { <option value="@sport">@sport</option> }</select>
        <span asp-validation-for="EventType" class="field-error"></span>
    </div>
    <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4" maxlength="1000" required></textarea><span asp-validation-for="Description" class="field-error"></span></div>
    <div class="col-md-4"><label asp-for="DistanceKm" class="form-label"></label><input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.01" max="9999.99" required /><span asp-validation-for="DistanceKm" class="field-error"></span></div>
    <div class="col-md-4"><label asp-for="EventDateTime" class="form-label"></label><input asp-for="EventDateTime" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" class="form-control" type="datetime-local" step="1" required /><span asp-validation-for="EventDateTime" class="field-error"></span></div>
    <div class="col-md-4"><label asp-for="EntryClosingDateTime" class="form-label"></label><input asp-for="EntryClosingDateTime" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" class="form-control" type="datetime-local" step="1" required /><span asp-validation-for="EntryClosingDateTime" class="field-error"></span></div>
    <div class="col-12"><p class="field-help mb-0">All dates and times use South African Standard Time (UTC+02:00). Entries must close before the event starts.</p></div>
    <div class="col-md-6"><label asp-for="VenueName" class="form-label"></label><input asp-for="VenueName" class="form-control" maxlength="120" required /><span asp-validation-for="VenueName" class="field-error"></span></div>
    <div class="col-md-6"><label asp-for="AddressLine1" class="form-label"></label><input asp-for="AddressLine1" class="form-control" maxlength="120" required /><span asp-validation-for="AddressLine1" class="field-error"></span></div>
    <div class="col-md-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" maxlength="80" required /><span asp-validation-for="City" class="field-error"></span></div>
    <div class="col-md-6">
        <label asp-for="Province" class="form-label"></label>
        <select asp-for="Province" class="form-select" required><option value="">Choose a province</option>@foreach (string province in new[] { "Eastern Cape", "Free State", "Gauteng", "KwaZulu-Natal", "Limpopo", "Mpumalanga", "Northern Cape", "North West", "Western Cape" }) { <option value="@province">@province</option> }</select>
        <span asp-validation-for="Province" class="field-error"></span>
    </div>
    <div class="col-md-6"><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" class="form-control" type="number" step="0.000001" min="-90" max="90" /><span asp-validation-for="Latitude" class="field-error"></span></div>
    <div class="col-md-6"><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" class="form-control" type="number" step="0.000001" min="-180" max="180" /><span asp-validation-for="Longitude" class="field-error"></span></div>
    <div class="col-12"><p class="field-help mb-0">Coordinates are optional. Supply both latitude and longitude or leave both blank.</p></div>
</div>
