   Accessed: 18 November 2026. *@
@model RaceDay.Web.Models.Profiles.ChangePasswordForm
@{
    ViewData["Title"] = "Change password";
}
<section class="events-section">
    <div class="container">
        <a class="back-link" asp-controller="Profile" asp-action="Index">Back to my profile</a>
        <div class="page-intro"><h1>Change password</h1><p>You will need to sign in again after saving your new password.</p></div>
        <div class="detail-panel profile-form-panel">
            <form asp-controller="Profile" asp-action="Password" method="post">
                <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>
                <div class="account-field">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control" value="" autocomplete="current-password" required aria-describedby="current-password-error" />
                    <span asp-validation-for="CurrentPassword" class="field-error" id="current-password-error"></span>
                </div>
                <div class="account-field">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" value="" autocomplete="new-password" required aria-describedby="new-password-error password-help" />
                    <span asp-validation-for="NewPassword" class="field-error" id="new-password-error"></span>
                    <p class="field-help" id="password-help">Use 8–128 characters with an upper-case letter, lower-case letter, digit and symbol.</p>
                </div>
                <div class="account-field">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" value="" autocomplete="new-password" required aria-describedby="confirm-password-error" />
                    <span asp-validation-for="ConfirmPassword" class="field-error" id="confirm-password-error"></span>
                </div>
                <div class="entry-actions mt-4">
                    <button class="btn btn-race" type="submit">Save password</button>
                    <a class="btn btn-outline-secondary" asp-controller="Profile" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>
