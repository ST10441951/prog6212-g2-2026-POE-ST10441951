@* Friendly error after an uncertain password change: Microsoft (2026).
   https://learn.microsoft.com/en-us/aspnet/core/fundamentals/error-handling?view=aspnetcore-10.0
   Accessed: 18 November 2026. *@
@{
    ViewData["Title"] = "Password change unconfirmed";
}
<section class="container error-page">
    <p class="eyebrow">503</p>
    <h1>Password change could not be confirmed</h1>
    <p>You have been signed out. Try signing in again; the password change may have been saved.</p>
    <a class="btn btn-race" asp-controller="Account" asp-action="Login">Sign in</a>
</section>
